# ─── Copy this file to .env and fill in your real values ───

# Server
PORT=3000
NODE_ENV=production

# JWT secret for auth tokens — use a long random string
JWT_SECRET=change-me-to-a-long-random-secret-string-min-32-chars

# PostgreSQL database (from Render → your Postgres instance → "Internal Database URL")
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Cloudinary (from Cloudinary Dashboard → Account Details)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# User passwords (bcrypt-hashed via `npm run initdb` prompts, or set plain here for first setup)
TREASURER_PASSWORD=Treasurer@2027
FINSEC_PASSWORD=FinSec@2027
RECSEC_PASSWORD=RecSec@2027

# CORS — the frontend URL (your Render static site URL)
FRONTEND_URL=https://nedlo-stokvel.onrender.com
